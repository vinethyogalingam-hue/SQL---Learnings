/*
For Electronics products:

If stock_quantity < 20 → increase stock by 10
If stock_quantity >= 20 → increase stock by 5

Use one UPDATE statement.

*/


UPDATE products
SET stock_quantity = CASE
        WHEN stock_quantity<20 THEN stock_quantity+10
        WHEN stock_quantity>=20 THEN stock_quantity+5
	END
WHERE category = 'Electronics';


/*

Update product prices based on both category and current price:

For Electronics:

Price < 5,000 → increase by 5%
Price >= 5,000 → increase by 10%

For Furniture:

Price < 5,000 → increase by 8%
Price >= 5,000 → increase by 12%
*/

SELECT * FROM products;
UPDATE products
SET price = CASE 
            WHEN category = 'Electronics' AND price<5000 THEN price+((price*5)/100)
            WHEN category = 'Electronics' AND price>=5000 THEN price+((price*10)/100)
			WHEN category = 'Furniture' AND price<5000 THEN price+((price*8)/100)
            WHEN category = 'Furniture' AND price>=5000 THEN price+((price*12)/100)
            END
WHERE category = 'Electronics' OR category = 'Furniture';

SELECT * FROM products;
UPDATE products
SET price = CASE 
			WHEN category = 'Furniture' AND price<5000 THEN price+((price*8)/100)
            WHEN category = 'Furniture' AND price>=5000 THEN price+((price*12)/100)
            END
WHERE category = 'Electronics' OR category = 'Furniture';


















